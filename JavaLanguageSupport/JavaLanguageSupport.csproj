<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- F2C: compila le immagini CPS come risorse WPF (JavaLanguageSupport.g.resources). -->
    <UseWPF>true</UseWPF>
    <!-- Gli XAML CPS sono schemi del Project System, non pagine WPF. -->
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>JavaLanguageSupport</AssemblyName>
    <RootNamespace>JavaLanguageSupport</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>true</IncludeDebugSymbolsInVSIXContainer>
    <!-- Build e deploy VSIX con SDK-style Visual Studio 2026 (18.5+). -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <VsixDeployOnDebug>true</VsixDeployOnDebug>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <StartAction>Program</StartAction>
    <StartProgram>$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>
  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.VisualStudio.TemplateWizardInterface" Version="17.10.40170" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.LanguageServer.Client" Version="17.14.60" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.38461" PrivateAssets="all" />
    <PackageReference Include="Microsoft.VisualStudio.Workspace.VSIntegration" Version="17.12.19" />
    <PackageReference Include="Microsoft.VisualStudio.ProjectSystem.SDK" Version="17.9.380" ExcludeAssets="runtime" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
  </ItemGroup>
  <ItemGroup>
    <VSCTCompile Include="Commands\Commands.vsct">
      <!-- Deve coincidere con [ProvideMenuResource("Menus.ctmenu", 1)]. -->
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <None Include="source.extension.vsixmanifest" />
    <Content Include="Configuration\JavaThemeColors.pkgdef">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Configuration\JavaTextMate.pkgdef">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Configuration\JavaLanguageSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Configuration\java-intellisense-language-configuration.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Grammars\java.tmLanguage.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
  <!-- Register theme-specific Java colors before VSIX packaging. -->
  <!-- SDK-style VSIX: VSInstallDir may be empty in managed builds. -->
  <PropertyGroup>
    <JavaVsixCompilerRelativePath>VSSDK\VisualStudioIntegration\Tools\Bin\VsixColorCompiler.exe</JavaVsixCompilerRelativePath>
    <!-- Preserve an explicit /p:JavaVsixColorCompiler or environment override. -->
    <JavaVsixColorCompiler Condition="'$(JavaVsixColorCompiler)' == '' and '$(VSInstallDir)' != '' and Exists('$(VSInstallDir)$(JavaVsixCompilerRelativePath)')">$(VSInstallDir)$(JavaVsixCompilerRelativePath)</JavaVsixColorCompiler>
    <JavaVsixColorCompiler Condition="'$(JavaVsixColorCompiler)' == '' and '$(DevEnvDir)' != '' and Exists('$(DevEnvDir)..\..\$(JavaVsixCompilerRelativePath)')">$([System.IO.Path]::GetFullPath('$(DevEnvDir)..\..\$(JavaVsixCompilerRelativePath)'))</JavaVsixColorCompiler>
    <JavaVsixColorCompiler Condition="'$(JavaVsixColorCompiler)' == '' and '$(VisualStudioInstallDir)' != '' and Exists('$(VisualStudioInstallDir)\$(JavaVsixCompilerRelativePath)')">$(VisualStudioInstallDir)\$(JavaVsixCompilerRelativePath)</JavaVsixColorCompiler>
  </PropertyGroup>
  <Target Name="GenerateJavaThemeColors" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(JavaVsixColorCompiler)' == '' or !Exists('$(JavaVsixColorCompiler)')" Text="VsixColorCompiler.exe non trovato. VSInstallDir puo' essere vuoto nei progetti SDK-style. Installare il workload 'Sviluppo di estensioni di Visual Studio', oppure impostare /p:JavaVsixColorCompiler=PATH_COMPLETO. Vedere la guida ZIP." />
    <Exec Command="&quot;$(JavaVsixColorCompiler)&quot; &quot;$(MSBuildProjectDirectory)\Configuration\JavaThemeColors.xml&quot; &quot;$(MSBuildProjectDirectory)\Configuration\JavaThemeColors.pkgdef&quot; /noLogo" />
  </Target>
  <!-- Pack F1: provide build-system template files in the EXISTING VSIX.
       Java projects copy these two files alongside their optional .javaproj. -->
  <ItemGroup>
    <Content Include="ProjectSystem\BuildSystem\JavaProject.props">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="ProjectSystem\BuildSystem\JavaProject.BrowseObject.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="ProjectSystem\BuildSystem\JavaProject.Items.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="ProjectSystem\BuildSystem\JavaProject.None.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="ProjectSystem\BuildSystem\JavaProject.JavaCompile.xaml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="ProjectSystem\BuildSystem\JavaProject.targets">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
  <!-- Java CPS F2A: VSIX native item templates -->
  <ItemGroup>
    <!-- Evita l'item None implicito degli SDK-style .csproj. -->
    <None Remove="ProjectSystem\Templates\ItemTemplates\Java\1033\*.zip" />
    <Content Include="ProjectSystem\Templates\ItemTemplates\Java\1033\*.zip">
      <IncludeInVSIX>true</IncludeInVSIX>
      <VSIXSubPath>ItemTemplates\Java\1033</VSIXSubPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- F2C: icone native CPS per progetto Java e sorgenti .java -->
  <ItemGroup>
    <Resource Include="ProjectSystem\Icons\JavaProject.Light.16.png" />
    <Resource Include="ProjectSystem\Icons\JavaProject.Light.32.png" />
    <Resource Include="ProjectSystem\Icons\JavaProject.Dark.16.png" />
    <Resource Include="ProjectSystem\Icons\JavaProject.Dark.32.png" />
    <Content Include="JavaProject.imagemanifest">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
  </ItemGroup>
  <!-- F2D-ITEM-ICONS-BEGIN -->
  <!-- 84 PNG come risorse WPF, *non* altre 84 asset VSIX. -->
  <ItemGroup>
    <Resource Include="ProjectSystem\Icons\Files\*.png" />
  </ItemGroup>
  <!-- F2D-ITEM-ICONS-END -->
</Project>
