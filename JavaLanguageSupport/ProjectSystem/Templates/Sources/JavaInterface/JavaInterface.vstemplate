<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Interfaccia Java</Name>
    <Description>Crea una interfaccia Java.</Description>
    <Icon>JavaInterface.ico</Icon>
    <ProjectType>Java</ProjectType>
    <AppliesTo>JavaLanguageSupportCps</AppliesTo>
    <DefaultName>Interface.java</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <SortOrder>30</SortOrder>
    <TemplateID>{bf3d4942-2473-4f1e-9403-9f7157bcedbc}</TemplateID>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.java">Interface.java</ProjectItem>
  </TemplateContent>
  <WizardExtension>
    <Assembly>JavaLanguageSupport, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null</Assembly>
    <FullClassName>JavaLanguageSupport.ProjectSystem.Templates.Wizards.JavaItemTemplateWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
