<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Classe Java</Name>
    <Description>Crea una classe Java pubblica.</Description>
    <Icon>JavaClass.ico</Icon>
    <ProjectType>Java</ProjectType>
    <AppliesTo>JavaLanguageSupportCps</AppliesTo>
    <DefaultName>Class.java</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <SortOrder>10</SortOrder>
    <TemplateID>{a5a9a39e-85c8-4efe-8c7c-5c22f49f62a1}</TemplateID>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.java">Class.java</ProjectItem>
  </TemplateContent>
</VSTemplate>
