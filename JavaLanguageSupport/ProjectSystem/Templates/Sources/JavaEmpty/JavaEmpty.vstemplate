<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>File Java vuoto</Name>
    <Description>Crea un file sorgente Java.</Description>
    <Icon>JavaEmpty.ico</Icon>
    <ProjectType>Java</ProjectType>
    <AppliesTo>JavaLanguageSupportCps</AppliesTo>
    <DefaultName>NewFile.java</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <SortOrder>70</SortOrder>
    <TemplateID>{08f6af42-f3cc-48cb-9e59-5fb333a29674}</TemplateID>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.java">NewFile.java</ProjectItem>
  </TemplateContent>
  <WizardExtension>
    <Assembly>JavaLanguageSupport, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null</Assembly>
    <FullClassName>JavaLanguageSupport.ProjectSystem.Templates.Wizards.JavaItemTemplateWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
