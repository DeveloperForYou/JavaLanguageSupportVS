<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Record Java</Name>
    <Description>Crea un record Java (Java 16+).</Description>
    <Icon>JavaRecord.ico</Icon>
    <ProjectType>Java</ProjectType>
    <AppliesTo>JavaLanguageSupportCps</AppliesTo>
    <DefaultName>Record.java</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <SortOrder>50</SortOrder>
    <TemplateID>{4569ea73-a9fa-4529-aa0f-8fa05cfeef3b}</TemplateID>
  </TemplateData>
  <TemplateContent>
    <ProjectItem ReplaceParameters="true" TargetFileName="$fileinputname$.java">Record.java</ProjectItem>
  </TemplateContent>
  <WizardExtension>
    <Assembly>JavaLanguageSupport, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null</Assembly>
    <FullClassName>JavaLanguageSupport.ProjectSystem.Templates.Wizards.JavaRecordPackageWizard</FullClassName>
  </WizardExtension>
</VSTemplate>
