<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <JavaBuildSystem Condition="'$(JavaBuildSystem)' == ''">Maven</JavaBuildSystem>
    <ProjectSystemBase>$(MSBuildThisFileDirectory)</ProjectSystemBase>
    <EnableDefaultJavaItems Condition="'$(EnableDefaultJavaItems)' == ''">true</EnableDefaultJavaItems>
  </PropertyGroup>
</Project>
