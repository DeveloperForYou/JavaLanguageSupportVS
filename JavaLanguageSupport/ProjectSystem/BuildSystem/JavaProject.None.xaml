<?xml version="1.0" encoding="utf-8"?>
<Rule Name="None" DisplayName="File" PageTemplate="generic"
      xmlns="http://schemas.microsoft.com/build/2009/properties">
  <Rule.DataSource>
    <DataSource Persistence="ProjectFile" ItemType="None" HasConfigurationCondition="False" />
  </Rule.DataSource>
  <StringProperty Name="Identity" DisplayName="Nome" ReadOnly="True">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="None" PersistedName="Identity" />
    </StringProperty.DataSource>
  </StringProperty>
  <StringProperty Name="FullPath" DisplayName="Percorso" ReadOnly="True">
    <StringProperty.DataSource>
      <DataSource Persistence="Intrinsic" ItemType="None" PersistedName="FullPath" />
    </StringProperty.DataSource>
  </StringProperty>
  <BoolProperty Name="Visible" Visible="False" />
  <StringProperty Name="DependentUpon" Visible="False" />
  <StringProperty Name="Link" Visible="False" />
</Rule>
